    "build": "vite build",
    "build:sibyl": "JOBS_OUT_DIR=../sibyl/public/plugins/jobs-plugin vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@ohdsi/atlas-ui": "^0.1.0-20260605045838-e3c7c92",
    "pinia": "^2.1.0",
