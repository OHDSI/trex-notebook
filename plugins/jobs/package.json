{
  "name": "@ohdsi/jobs-plugin",
  "version": "0.1.0",
  "description": "HADES/Strategus jobs overview and R environment management for Atlas3",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.system.js",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "@ohdsi:registry": "https://npm.pkg.github.com"
  },
  "scripts": {
