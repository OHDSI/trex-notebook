    "vuetify": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.2",
    "single-spa-vue": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.21",
    "vite-plugin-vuetify": "^2.0.0",
    "vitest": "^3.2.1",
    "vue-tsc": "^2.1.0"
  }
