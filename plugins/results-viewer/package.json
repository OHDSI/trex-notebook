{
  "name": "@ohdsi/results-viewer",
  "version": "0.2.0",
  "description": "OHDSI HADES analysis results viewer — Shiny via WebR + DuckDB",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.system.js",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "@ohdsi:registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sibyl": "RESULTS_VIEWER_OUT_DIR=../sibyl/public/plugins/results-viewer vite build",
    "build:pkg": "RESULTS_VIEWER_OUT_DIR=dist vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@ohdsi/atlas-ui": "^0.1.0-20260605045838-e3c7c92",
    "jszip": "^3.10.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.4.0",
    "vuetify": "^3.12.6",
    "webr": "^0.5.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "single-spa-vue": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.21",
    "vue-tsc": "^2.1.0"
  }
}
